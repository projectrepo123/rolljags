{
  "name": "rolljags-photos",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "rolljags-photos"
    }
  ],
  "routes": [
    {
      "pattern": "rolljags.com",
      "custom_domain": true
    }
  ]
}
