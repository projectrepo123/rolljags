{
  "name": "rolljags-photos",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "rolljags-photos"
    }
  ],
  "ratelimits": [
    {
      "name": "ZIP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 6, "period": 60 }
    }
  ],
  "routes": [
    {
      "pattern": "rolljags.com",
      "custom_domain": true
    }
  ]
}
